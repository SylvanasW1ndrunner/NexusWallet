# Nexus AA - Environment Variables Configuration

# ============================================
# Infura Configuration
# ============================================
# Get your Infura project ID from https://infura.io
INFURA_ID=your_infura_project_id_here

# ============================================
# Pimlico Bundler Configuration
# ============================================
# Get your API key from https://dashboard.pimlico.io
PIMLICO_API_KEY=your_pimlico_api_key_here

# ============================================
# Private Key (for EOA wallet)
# ============================================
# WARNING: Never commit your private key to version control!
# This is used for testing purposes only
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ============================================
# Transaction Aggregation Service - Database
# ============================================
# PostgreSQL connection URL
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_aa

# ============================================
# Transaction Aggregation Service - Redis
# ============================================
# Redis connection URL
# Format: redis://hostname:port/database_number
REDIS_URL=redis://localhost:6379/0

# ============================================
# Transaction Aggregation Service - API
# ============================================
# API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Transaction Aggregation Service - Cache TTL
# ============================================
# Cache time-to-live settings (in seconds)
CACHE_TTL_PENDING_TXS=300       # 5 minutes
CACHE_TTL_TX_DETAIL=600         # 10 minutes
CACHE_TTL_ACCOUNT_OWNERS=1800   # 30 minutes

# ============================================
# Transaction Aggregation Service - Database Pool
# ============================================
# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ============================================
# Testing Configuration
# ============================================
# API base URL for testing
API_BASE_URL=http://localhost:8000

# Test password for wallet encryption
TEST_PASSWORD=TestPassword123!

# Default network for testing
TEST_NETWORK=sepolia
