# Infura API Key (get from https://infura.io)
INFURA_ID=your_infura_api_key_here

# Or use a direct RPC URL
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY

# Deployer private key (without 0x prefix)
# WARNING: Never commit this file with real keys!
PRIVATE_KEY=your_private_key_here

# Mnemonic file (optional, alternative to private key)
MNEMONIC_FILE=mnemonic.txt

# Pimlico API Key (get from https://dashboard.pimlico.io)
PIMLICO_API_KEY=your_pimlico_api_key_here

# Etherscan API Key for contract verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
